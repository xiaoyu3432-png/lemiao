{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "strict": true, "sourceMap": true, "baseUrl": ".", "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] }, "lib": ["ESNext", "DOM"],
    "types": ["@dcloudio/types", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}
