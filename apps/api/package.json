{
  "name": "@lemiao/api", "version": "0.1.0", "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json", "start": "node dist/main.js",
    "typecheck": "tsc --noEmit", "test": "jest --runInBand"
  },
  "dependencies": {
    "@lemiao/contracts": "workspace:*", "@nestjs/common": "11.2.6", "@nestjs/core": "11.2.6",
    "@nestjs/config": "4.0.4", "@nestjs/platform-express": "11.2.6", "@nestjs/swagger": "11.4.7",
    "mysql2": "3.15.3", "reflect-metadata": "0.2.2", "rxjs": "7.8.2", "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6", "@types/express": "5.0.3", "@types/jest": "29.5.14",
    "@types/node": "22.18.10", "@types/supertest": "6.0.3", "jest": "29.7.0",
    "nodemon": "3.1.10", "supertest": "7.1.4", "ts-jest": "29.4.5", "ts-node": "10.9.2", "typescript": "5.9.3"
  },
  "jest": { "preset": "ts-jest", "testEnvironment": "node", "testMatch": ["<rootDir>/test/**/*.spec.ts"], "clearMocks": true }
}
